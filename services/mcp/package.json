{
  "name": "@sleeping-giants/mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @sleeping-giants/shared build && pnpm --filter @sleeping-giants/data build && tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.0",
    "@fastify/rate-limit": "^8.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@sleeping-giants/data": "workspace:*",
    "@sleeping-giants/shared": "workspace:*",
    "fastify": "^4.25.2",
    "nestjs-pino": "^4.0.0",
    "pino": "^8.17.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/node": "^20.11.19",
    "vite-tsconfig-paths": "^4.3.1"
  }
}
